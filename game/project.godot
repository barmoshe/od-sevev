; Engine configuration file.
; "עוד סבב" (od-sevev): a fork of Monkey Bananas v2.1.0, Godot 4.7 project. Portrait base
; 720x1280 (= the 180x320 art canvas at x4), stretch aspect "expand" so tall phones grow the
; stage instead of letterboxing. Hebrew, RTL: text shaping and bidi go through TextServer
; (TextServerAdvanced, the default driver). include_text_server_data stays off: Hebrew needs no
; dictionary line breaking (engine/feasibility.md U6).

config_version=5

[application]

config/name="עוד סבב"
config/description="שולפים שקלים מהכובע, משלמים לשותפים ודוחים את המשפט."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/version="0.1.0"
config/icon="res://assets/icon/icon_1024.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="od-sevev"
boot_splash/bg_color=Color(0, 0.137, 0.478, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icon/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
run/max_fps=0

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
general/default_playback_type.web=0

[autoload]

Art="*res://scripts/art/art.gd"
Juice="*res://scripts/ui/juice.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
viewport/hdr_2d=false
environment/defaults/default_clear_color=Color(0.165, 0.137, 0.251, 1)
