      "priority": 3,
      "polyphony": 3,
      "steal": "oldest",
      "cooldownMs": 0,
      "followsKey": true,
      "loadBearingBandHz": [880, 2100],
      "lengthMs": 81,
      "randomize": {
        "pitch": { "mode": "scale", "scaleSemis": [0, 3, 5, 8, 10, 12, 15, 17], "window": 3, "noRepeat": true },
