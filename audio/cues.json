{
  "version": 1,
  "_doc": "Monkey Bananas cue-spec (machine-readable). Owner: Audio Director. The developer implements this directly: no audio files exist. Keys that start with '_' are documentation, so ignore them at runtime. The full field reference is in audio-cue-spec.md section 3, and the reference implementation is preview.html (function ChipAudio).",
  "_schema": {
    "pitch": "Every frequency is either a number (Hz) or a note name in scientific pitch ('A4' = globals.a4Hz, sharps '#', flats 'b', e.g. 'Bb3').",
    "cue": {
      "event": "mechanic-spec event id(s) that fire this cue (see the 'events' map for the full mapping)",
      "bus": "'sfx' | 'ui'   (music has its own bus, driven by music.json)",
      "gainDb": "cue level in dB applied to the cue instance (layers are linear and relative inside it)",
      "priority": "1 critical, 2 high, 3 normal, 4 low. Used for global voice stealing",
      "polyphony": "max simultaneous instances of THIS cue",
      "steal": "'oldest' = fade the oldest instance over globals.stealFadeMs and play the new one | 'none' = drop the new trigger",
      "cooldownMs": "minimum time between two starts of this cue; triggers inside the window are dropped",
      "followsKey": "true = add the music key offset (music.json keyOffsetByEvolutions) to every followPitch layer",
      "loadBearingBandHz": "[lo, hi] band where the cue is recognizable (frequency-slot contract)",
      "lengthMs": "longest layer end (delay + duration + release) in ms, informational",
      "randomize.pitch": "{mode:'none'} | {mode:'scale', scaleSemis:[..], window:n, noRepeat:bool}: pick scaleSemis[i] with i random in [base, base+window-1] (base = streak step), never the same i twice in a row if noRepeat",
      "randomize.gainDb": "+/- uniform random dB added per trigger",
      "streak": "{gapMs, tapsPerStep, maxSteps}: consecutive triggers closer than gapMs build a streak; step = min(maxSteps, floor((count-1)/tapsPerStep)); a gap >= gapMs resets count to 0",
      "rateComp": "{windowMs, startRate, fullRate, maxCutDb}: rate = triggers in the last windowMs; gain cut = maxCutDb * clamp((rate-startRate)/(fullRate-startRate), 0, 1)",
      "replaces": "cue ids this cue plays INSTEAD of for the same input (the caller must not also play them)",
      "duck": "[{target:'bus:music'|'cue:<id>', db, attackMs, holdMs | until:'<eventId>', releaseMs}] applied when the cue starts; overlapping ducks on one target take the minimum (deepest) dB",
      "conditionalLayers": "[{when:'<flag>', layers:[..]}]: extra layers added while the runtime flag is true at trigger time",
      "layers": "array of layer objects, see 'layer'"
    },
    "layer": {
      "id": "readable name",
      "wave": "'pulse' | 'square' | 'triangle' | 'sine' | 'noise' | 'noiseMetal'   ('sawtooth' is legal in the engine but banned by sonic-brief.md)",
      "duty": "pulse only: 0.125 | 0.25 (use wave 'square' for 0.5). Built as a PeriodicWave, see globals.pulseWave",
      "freqStart / freqEnd": "tonal waves. freqEnd defaults to freqStart",
      "freqCurve": "'exp' (default) | 'lin' | 'step' shape of the freqStart->freqEnd move",
      "glide": "seconds for the freqStart->freqEnd move (default = duration)",
      "clockStart / clockEnd": "noise waves only: LFSR clock in Hz; playbackRate = clock / ctx.sampleRate. Higher = brighter. clockEnd defaults to clockStart",
      "followPitch": "default true for tonal waves, false for noise: whether the cue pitch offset (key + random + streak + param) multiplies this layer's frequency",
      "detuneJitterSemis": "optional +/- continuous random detune for this layer only (used on percussive thumps, never on tonal notes)",
      "gain": "linear 0..1, relative within the cue",
      "attack": "s, linear ramp 0 -> gain",
      "decay": "s, ramp gain -> gain*sustain (shape = envCurve)",
      "sustain": "0..1 level held until duration ends",
      "duration": "s from onset to release start; MUST be >= attack + decay. In music.json instruments it may be the string 'note' (= note length * instrument gate)",
      "release": "s, ramp to silence (shape = envCurve)",
      "envCurve": "'exp' (default, exponentialRamp to 0.0001 floor) | 'lin'",
      "delay": "s offset from the cue start (default 0)",
      "filter": "optional {type:'lowpass'|'highpass'|'bandpass', freq, freqEnd?, Q}; freqEnd sweeps exponentially over duration. Q is passed straight to BiquadFilterNode.Q, i.e. Web Audio semantics: for lowpass/highpass it is resonance in dB (0.7 = +0.7 dB, a mild bump), for bandpass it is the linear Q",
      "vibrato": "optional {rateHz, depthCents, delay}: sine LFO into the oscillator's detune, ramps in over 50 ms after 'delay'",
      "arpeggio": "optional [semitone offsets], stepped with setValueAtTime every 1/arpRateHz s. Overrides freqEnd (a layer has a sweep OR an arpeggio, never both)",
      "arpRateHz": "steps per second",
      "arpLoop": "default true (cycle the list until the voice ends); false = play the list once and hold the last value",
      "crush": "optional int bits (4 = 16 levels): staircase WaveShaper on the raw oscillator BEFORE the envelope. 4 on a triangle = NES triangle"
    }
  },
  "globals": {
    "a4Hz": 440,
    "maxCueInstances": 20,
    "stealFadeMs": 6,
    "pulseWave": "PeriodicWave with real[n] = (2/(n*PI))*sin(n*PI*duty), imag[n] = 0 for n = 1..64 (real[0] = imag[0] = 0), default normalization ON. Cache one wave per duty.",
    "noise": "Pre-generate once per AudioContext: 'noise' = 15-bit LFSR long mode (feedback = bit0 XOR bit1), 'noiseMetal' = short mode (bit0 XOR bit6); seed 1; output bit0 ? -1 : +1; one LFSR step per sample; buffer length = exactly one LFSR period (32767 samples in long mode; the detected period in short mode), loop = true, start at a random offset.",
    "crushCurve": "Mid-tread staircase WaveShaper curve (0 maps to 0, so there is no DC): N = 4096 points, H = 2^(bits-1): for i in 0..N-1 { x = 2*i/(N-1) - 1; curve[i] = Math.round(x*H)/H }. That is 2^bits + 1 levels (17 for crush 4). oversample 'none' (the aliasing grit is intended). Cache one curve per bit depth.",
    "flags": ["tapFrenzyActive", "frenzyActive"]
  },
  "mix": {
    "_doc": "mix-bus-topology, machine-readable. Human spec and rationale: mix-bus-topology.md. Graph: cue instance -> cueGroup[cueId] (duckable) -> busUser[bus] (settings toggle, 0|1) -> bus[bus] (gainDb) -> master (preGainDb) -> DynamicsCompressor -> outputTrim -> destination. Music: channel -> layerGain -> musicMix -> musicState (evolve fades) -> musicDuck (ducks) -> busUser.music -> bus.music.",
    "buses": {
      "music": { "gainDb": -12.5, "toggle": "settings.music" },
      "sfx":   { "gainDb": 0,  "toggle": "settings.sfx" },
      "ui":    { "gainDb": 0,  "toggle": "settings.sfx" }
    },
    "master": {
      "preGainDb": -1.7,
      "compressor": { "threshold": -14, "knee": 8, "ratio": 6, "attack": 0.002, "release": 0.2 },
      "outputTrimDb": 0
    },
    "toggleRampMs": 30,
    "balance": {
      "_doc": "Foreground/bed balance targets (rebalance 2026-09-27, mix-bus-topology.md section 7). Metric: max K-weighted loudness of the cue in any 100 ms window, minus the median 100 ms K-weighted loudness of the base music bed (sections A A2 B B2, evolutions 0), both through the full engine chain, randomize.gainDb off. 'phone' = both renders through a 300 Hz Butterworth high-pass (small-speaker proxy, the design baseline); 'full' = no filter (headphones). preview.html -> 'Balance vs music bed' measures it.",
      "windowMs": 100,
      "phoneHighpassHz": 300,
      "minOverBedLU": {
        "tap":        { "phone": 3,  "full": -1 },
        "tapCrit":    { "phone": 5,  "full": 1 },
        "buy":        { "phone": 3,  "full": -1 },
        "uiClick":    { "phone": -1, "full": -6 },
        "uiToggleOn": { "phone": -3, "full": -9 }
      }
    }
  },
  "unlock": {
    "_doc": "Autoplay-unlock and audio-session contract, machine-readable. Human rules U1-U10: audio-cue-spec.md section 5. Reference implementation: preview.html -> class AudioUnlock.",
    "gestureEvents": ["pointerdown", "pointerup", "touchend", "click", "keydown"],
    "listenerOptions": { "capture": true, "passive": true },
    "listenersLifetime": "page",
    "firstCueDeferMaxMs": 180,
    "firstCueQueueSlots": 1,
    "kickBufferSamples": 1,
    "iosSession": { "musicOn": "playback", "musicOff": "ambient" },
    "legacySilentElement": { "when": "iOS WebKit without navigator.audioSession, and settings.music is on", "wav": { "sampleRate": 8000, "bitDepth": 16, "channels": 1, "seconds": 0.5 }, "loop": true, "playsinline": true }
  },
