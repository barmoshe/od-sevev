  "events": {
    "_doc": "Gameplay event -> audio action. 'cue' = cue id to play (null = none). 'music' = a MusicPlayer call (see music.json 'transitions'). 'flag' = runtime flag set or cleared. 'added': true marks events that are NOT in mechanic-spec section 9's list; the developer must emit them (derivations are given in audio-cue-spec.md section 4).",
    "tap":                 { "cue": "tap" },
    "tapCrit":             { "cue": "tapCrit", "note": "Play INSTEAD of 'tap' for the same pointer-down (cues.tapCrit.replaces). Count it toward tap's streak and rateComp." },
    "buy":                 { "cue": "buy", "note": "Exactly 1 unit bought (x1 mode, or a hold-to-repeat tick)." },
    "buyBulk":             { "cue": "buyBulk", "note": "More than 1 unit in one commit (x10 / MAX)." },
    "cantAfford":          { "cue": "cantAfford" },
    "upgradeBuy":          { "cue": "upgradeBuy" },
    "goldenSpawn":         { "cue": "goldenSpawn" },
    "goldenCatch":         { "cueByOutcome": { "bunch": "goldenCatchBunch", "frenzy": "goldenCatchFrenzy", "tapFrenzy": "goldenCatchTapFrenzy" } },
    "goldenDespawn":       { "cue": "goldenDespawn", "note": "Missed Golden only (not on catch)." },
    "frenzyStart":         { "cue": null, "music": "layerOn:frenzy", "flag": "frenzyActive=true", "note": "The catch cue is the audible start. A re-roll that refreshes the timer is a no-op here." },
    "frenzyEnd":           { "cue": "buffEnd", "music": "layerOff:frenzy", "flag": "frenzyActive=false" },
    "tapFrenzyStart":      { "cue": null, "music": "layerOn:frenzy", "flag": "tapFrenzyActive=true" },
    "tapFrenzyEnd":        { "cue": "buffEnd", "music": "layerOff:frenzy", "flag": "tapFrenzyActive=false" },
    "milestoneHeadline":   { "cue": "milestoneHeadline", "note": "Milestones only (the once-ever headlines), never ambient ticker text." },
    "evolveReady":         { "cue": "evolveReady", "added": true },
    "evolveOpen":          { "cue": "evolveOpen", "note": "Also starts the 'until' duck on bus:music." },
    "evolveClose":         { "cue": "panelClose", "added": true, "note": "Dialog dismissed without evolving: releases the evolveOpen duck." },
    "evolveConfirm":       { "cue": "evolveConfirm", "music": "fadeOutStop:400", "note": "Releases the evolveOpen duck at the same time (the fade takes over)." },
    "evolveTransitionEnd": { "cue": null, "added": true, "music": "restart", "restartNotBefore": { "event": "evolveConfirm", "plusMs": 1470 }, "note": "Emitted when input unlocks: evolveConfirm + 1500 ms normally, + 1200 ms under reduced motion (the Animator's dark crossfade). The music restart is scheduled at max(now, evolveConfirm time + 1470 ms = the fanfare's end), so it never overlaps the old-key fanfare tail. It restarts at bar 1 with the new keyOffset and fades in over 300 ms." },
    "offlineCollect":      { "cue": "offlineCollect" },
    "producerReveal":      { "cue": "producerReveal", "added": true },
    "becameAffordable":    { "cue": "affordGlint", "added": true },
    "uiClick":             { "cue": "uiClick", "added": true },
    "uiToggle":            { "cueByValue": { "true": "uiToggleOn", "false": "uiToggleOff" }, "added": true },
    "buyModeCycle":        { "cue": "uiToggleOn", "semisByMode": { "1": 0, "10": 4, "max": 7 }, "added": true },
    "panelOpen":           { "cue": "panelOpen", "added": true },
    "panelClose":          { "cue": "panelClose", "added": true },
    "audioUnlock":         { "cue": null, "added": true, "music": "start", "note": "Fired exactly once per page session, on the first transition of the AudioContext to state running (after a gesture retry, or at boot if the context was created running). Rules U1-U10 in audio-cue-spec.md section 5; numbers in the top-level unlock block." }
  }
