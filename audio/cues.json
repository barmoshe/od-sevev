      },
      "streak": { "gapMs": 350, "tapsPerStep": 6, "maxSteps": 4 },
      "rateComp": { "windowMs": 1000, "startRate": 6, "fullRate": 16, "maxCutDb": 6 },
      "_design": "Root A5. The pool is F-major pentatonic (A C D F G A C D). Each tap picks one of 3 adjacent degrees, never repeating, so 100 taps are never a machine-gun. The streak climbs one degree per 6 fast taps, up to +4 degrees (G6-A6-C7 at the top). Above 6 taps/s the level drops by up to 6 dB (full cut at 16/s), so a 16/s stream stays within about 2 LU of a 4/s one (rebalance 2026-09-27, mix-bus-topology.md section 7).",
      "layers": [
        { "id": "plink", "wave": "triangle", "freqStart": "G5", "freqEnd": "A5", "freqCurve": "exp", "glide": 0.012,
          "gain": 1.0, "attack": 0.001, "decay": 0.07, "sustain": 0, "duration": 0.071, "release": 0.01 },
        { "id": "click", "wave": "noise", "clockStart": 48000, "filter": { "type": "highpass", "freq": 5000, "Q": 0.7 },
          "gain": 0.3, "attack": 0.0005, "decay": 0.012, "sustain": 0, "duration": 0.0125, "release": 0.004 },
        { "id": "thump", "wave": "triangle", "freqStart": 420, "freqEnd": 150, "freqCurve": "exp", "glide": 0.035, "followPitch": false, "detuneJitterSemis": 1,
          "gain": 0.45, "attack": 0.001, "decay": 0.045, "sustain": 0, "duration": 0.046, "release": 0.008 }
