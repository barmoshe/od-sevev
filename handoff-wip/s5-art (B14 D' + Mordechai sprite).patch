         bx0 = 0 if side == 0 else 122
         L.hline(bx0, bx0 + 57, FLOOR - 7, "grey"); L.hline(bx0, bx0 + 57, FLOOR - 3, "grey")
         for x in range(bx0 + 2, bx0 + 58, 9):
