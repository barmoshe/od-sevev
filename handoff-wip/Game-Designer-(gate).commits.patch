 	_session_gates(runner, "mixed", r)
 	var s: GameState = r["state"]
 	print("           switches %d, fresh-face rounds pay +%d%%" % [int(s.stats.get("leaderSwitches", 0)), int(Leaders.ls()["pick"]["freshFaceBasePct"])])
