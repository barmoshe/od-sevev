+
+
+## The stamp's text scale `t` ms into its slam (-1 = at rest): 6 for 30 ms, 5 for 30, then 4.
+static func tag_slam_px(t: float) -> int:
+	if t < 0.0 or t >= 3.0 * TAG_SLAM_STEP_MS:
