+	await _frames(3)
+	var shop: Node = m.get("shop")
+	runner.check(shop != null and shop.get_node_or_null("../../..") == m and m.has_method("audio_event"),
+		"Shop's ../../.. is main, which has audio_event")
+	m.set_process(false)
+	tree.root.remove_child(m)
+	m.queue_free()
+	var d := DirAccess.open(dir)
+	if d:
