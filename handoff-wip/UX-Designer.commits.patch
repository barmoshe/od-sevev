diff --git a/ux/tools/mobile_mockup.py b/ux/tools/mobile_mockup.py
new file mode 100644
index 0000000..2d332e8
--- /dev/null
+++ b/ux/tools/mobile_mockup.py
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Wireframes for ux/mobile-first-layout.md: today's layout vs the spec, per device, drawn at CSS px.
+
+    python3 ux/tools/mobile_mockup.py        # writes ux/mockups/mobile-first-*.png
+
+Band diagrams, not art: every region is a flat box with its name and height (art px). Numbers
+come from ux/tools/mobile_layout.py (the spec) and rtl-map §1's old flex rule (today).
+"""
+import os
+import sys
+from PIL import Image, ImageDraw, ImageFont
+
+sys.path.insert(0, os.path.dirname(__file__))
+import mobile_layout as ML  # noqa: E402
+
+OUT = os.path.join(os.path.dirname(__file__), "..", "mockups")
+C = {
+    "hud": (20, 12, 36), "sky": (48, 40, 88), "stage": (70, 62, 110), "hit": (228, 196, 92), "lane": (42, 35, 64),
+    "ticker": (27, 20, 38), "card": (60, 48, 110), "silh": (44, 38, 70), "empty": (42, 35, 64), "tabs": (30, 22, 54),
+    "dead": (160, 40, 60), "text": (240, 236, 228), "muted": (170, 164, 190), "pad": (22, 18, 32), "tile": (74, 58, 128),
+}
+try:
+    FONT = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 11)
+    FONT_B = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 13)
+except OSError:
+    FONT = FONT_B = ImageFont.load_default()
+
+
+def old_flex(R):
+    if R >= 1018:
+        return 640 + ML.floor4(0.4 * (R - 1018)), R - (640 + ML.floor4(0.4 * (R - 1018)))
+    s = max(460, min(640, ML.floor4(R - 240)))
+    return s, R - s
+
+
+def box(d, sc, x0, w, y0, y1, fill, label="", dead=False, outline=None):
+    a, b = y0 * sc, y1 * sc
+    d.rectangle([x0, a, x0 + w - 1, b - 1], fill=fill, outline=outline)
+    if dead:
+        for yy in range(int(a), int(b), 6):
+            d.line([x0, yy, x0 + w, yy + 6], fill=C["dead"])
+    if label and b - a >= 11:
+        d.text((x0 + 6, a + 2), label, fill=C["text"], font=FONT)
+
+
+def panel(dev, mode, state):
+    r = ML.layout(dev)
+    lpc = 4 / r["artCss"]
+    sc = 1 / lpc                                  # logical → CSS px
+    wcss, hcss = dev[1], dev[2]
+    img = Image.new("RGB", (wcss, hcss + 34), C["pad"])
+    d = ImageDraw.Draw(img)
+    vh = ML.floor4(r["logical"][1])
+    top = r["insets"][0]
+    art = lambda px: f"{int(round(px / 4))} art"
+    full = int(round(r["logical"][0] * sc))
+    if mode == "today":
+        S, P = old_flex(vh - 368)
+        ox = int(round(ML.floor4((r["logical"][0] - 720) / 2) * sc))
+        colw = int(round(720 * sc))
+    else:
+        S, P = r["S"], r["P"]
+        ox, colw = 0, full
+    y = top
+    box(d, sc, 0, full, 0, y + 96, C["hud"], "Row A  money ×%d  (24 art)" % (5 if mode == "today" else 6))
+    y += 96
+    rowb_up = state == "mid"
+    if rowb_up:
+        box(d, sc, 0, full, y, y + 84, C["hud"], "Row B  seats (21 art)")
+    elif mode == "today":
+        box(d, sc, 0, full, y, y + 84, C["hud"], "Row B slot EMPTY until C2 (21 art)", dead=True)
+    else:
+        box(d, sc, 0, full, y, y + 84, C["sky"], "sky shows through until C2")
+    y += 84
+    st = y
+    box(d, sc, 0, full, st, st + S, C["sky"], "stage S = %d (%s)" % (S, art(S)))
+    hit_h = 416 if S >= 560 else 312
+    hb = st + S - 140
+    hx = (r["logical"][0] - 376) / 2 * sc
+    d.rectangle([hx, (hb - hit_h) * sc, hx + 376 * sc, hb * sc], outline=C["hit"], width=2)
+    d.text((hx + 6, (hb - hit_h) * sc + 4), "leader hit", fill=C["hit"], font=FONT)
+    lane_dead = mode == "today"
+    box(d, sc, 0, full, st + S - 96, st + S, C["lane"], "lane 24 art" + (" (flat stripes)" if lane_dead else " (textured apron)"), dead=lane_dead)
+    y = st + S
+    if mode == "today":
+        box(d, sc, 0, full, y, y + 84, C["empty"])
+    box(d, sc, ox, colw, y, y + 84, C["ticker"], "ticker: crawl 324 wide, cut words" if mode == "today" else "ticker: 2-line pages, clip %d" % r["clip"])
+    y += 84
+    tabs_up = state == "mid"
+    pane_end = y + P if (tabs_up or mode == "today") else y + P + 104
+    if mode == "today":
+        box(d, sc, 0, full, y, vh, C["empty"])
+    ncards = 4 if state == "bought" else 3
+    cy = y
+    for i in range(20):
+        if cy >= pane_end:
+            break
+        is_card = i < ncards
+        bottom = min(cy + 120, pane_end)
+        if not is_card and mode == "today":
+            break
+        box(d, sc, ox + 16 * sc, colw - 32 * sc, cy + 4, bottom - 4, C["card"] if is_card else C["silh"],
+            ("card %d" % (i + 1)) if is_card else "silhouette (dim, no price)")
+        cy += 120
+    if mode == "today" and cy < pane_end:
+        box(d, sc, 0, full, cy, pane_end, C["empty"], "EMPTY pane (%s)" % art(pane_end - cy), dead=True)
+    if tabs_up:
+        box(d, sc, ox, colw, pane_end, pane_end + 104, C["tabs"], "tab bar 26 art (pinned)")
+    elif mode == "today":
+        box(d, sc, 0, full, pane_end, pane_end + 104, C["empty"], "tab slot EMPTY until C1 (26 art)", dead=True)
+    title = "%s  %s  (%s)" % (dev[0], "TODAY" if mode == "today" else "SPEC", "after the 1st buy" if state == "bought" else "after C1 + C2")
+    d.rectangle([0, hcss, wcss, hcss + 34], fill=(255, 255, 255))
+    d.text((6, hcss + 9), title, fill=(0, 0, 0), font=FONT_B)
+    return img
+
+
+def picker_panel(dev, mode):
+    r = ML.layout(dev)
+    sc = r["artCss"] / 4
+    wcss, hcss = dev[1], dev[2]
+    img = Image.new("RGB", (wcss, hcss + 34), C["sky"])
+    d = ImageDraw.Draw(img)
+    vh = ML.floor4(r["logical"][1])
+    cw = r["cw"]
+    p = r["pickFirst"]
+    if mode == "today":
+        tw, th, A = 216, 156 + 128, 128
+        header = 196
+        avail = vh - header - 112 - 16
+        gy = header + max(0, (avail - (3 * th + 24)) // 2)
+        cols = [(r["logical"][0] - 720) / 2 + x for x in (488, 252, 16)]
+    else:
+        tw, th, A = p["tw"], p["th"], p["A"]
+        gy = vh - 16 - 112 - (3 * th + 24)
+        cols = [cw - 16 - tw, ML.floor4((cw - tw) / 2), 16]
+    # header
+    d.rectangle([0, 12 * sc, wcss, (12 + 116) * sc], fill=(90, 70, 30))
+    d.text((8, 16 * sc), "wordmark (pinned top)", fill=C["text"], font=FONT)
+    ty = (gy - 72) if mode == "spec" else 140
+    d.text((8, (ty + 6) * sc), "title line" + (" (16 above the grid)" if mode == "spec" else ""), fill=C["text"], font=FONT)
+    for row in range(3):
+        for c in range(3):
+            x = cols[c] * sc
+            yy = (gy + row * (th + 12)) * sc
+            d.rectangle([x, yy, x + tw * sc - 1, yy + th * sc - 1], fill=C["tile"], outline=(20, 16, 40))
+            ax = x + (tw - A) / 2 * sc
+            ay = yy + (th - (A + 8 + 44 + 80)) / 2 * sc
+            d.ellipse([ax, ay, ax + A * sc, ay + A * sc], fill=(200, 170, 150) if not (row == 1 and c == 1) else (240, 236, 228))
+    gb = gy + 3 * th + 24
+    strip_y = vh - 16 - 112
+    if mode == "today" and strip_y - gb > 32:
+        d.rectangle([0, gb * sc, wcss, strip_y * sc], fill=C["pad"])
+        for yy in range(int(gb * sc), int(strip_y * sc), 6):
+            d.line([0, yy, wcss, yy + 6], fill=C["dead"])
+        d.text((8, gb * sc + 4), "EMPTY %d art under the grid" % ((strip_y - gb) // 4), fill=C["text"], font=FONT)
+    d.rectangle([0, strip_y * sc, wcss, (vh - 16) * sc], fill=C["ticker"])
+    d.text((8, strip_y * sc + 6), "caption strip (blurb / disclaimer)", fill=C["text"], font=FONT)
+    title = "%s  LEADER_PICK  %s  (tile %d×%d, avatar %d)" % (dev[0], "TODAY" if mode == "today" else "SPEC", tw, th, A)
+    d.rectangle([0, hcss, wcss, hcss + 34], fill=(255, 255, 255))
+    d.text((6, hcss + 9), title, fill=(0, 0, 0), font=FONT_B)
+    return img
+
+
+def strip(images, path):
+    W = sum(i.width for i in images) + 16 * (len(images) - 1)
+    H = max(i.height for i in images)
+    out = Image.new("RGB", (W, H), (255, 255, 255))
+    x = 0
+    for i in images:
+        out.paste(i, (x, 0))
+        x += i.width + 16
+    out.save(path)
+    print("wrote", os.path.relpath(path))
+
+
+def main():
+    os.makedirs(OUT, exist_ok=True)
+    devs = {d[0]: d for d in ML.DEVICES}
+    for key in ["390×844@3", "430×932@3", "SE 375×667@2", "360×780@3"]:
+        dev = devs[key]
+        slug = key.replace("×", "x").replace(" ", "-").replace("@", "at")
+        strip([panel(dev, "today", "bought"), panel(dev, "spec", "bought"), panel(dev, "spec", "mid")],
+              os.path.join(OUT, "mobile-first-%s.png" % slug))
+    strip([picker_panel(devs["390×844@3"], "today"), picker_panel(devs["390×844@3"], "spec"),
+           picker_panel(devs["SE 375×667@2"], "today"), picker_panel(devs["SE 375×667@2"], "spec")],
+          os.path.join(OUT, "mobile-first-picker.png"))
+
+
+if __name__ == "__main__":
+    main()
