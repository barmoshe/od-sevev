+				const p = pills[0];
+				act('drag thread');
+				await drag(css(360 + st.disp.ox, (top + bot) / 2), -(p[1] - (top + bot) / 2) * st.disp.f / DPR * 0.9, 10);
+				await wait(300);
+			}
+		}
+		act('esc chat');
