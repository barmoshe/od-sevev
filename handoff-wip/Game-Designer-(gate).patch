+			if (vis.length) {
+				const p = vis[vis.length - 1];
+				act(`pill ${p[2]}`);
+				await tapAt(css(p[0], p[1]));
+				st.paid++;
+				await wait(p[4] ? 3400 : 350);   // a ceremony's ribbon runs 3 s of real time; a stamp needs a beat
