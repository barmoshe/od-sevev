+				_tags.remove_at(qi)
+	if _passive and _t >= 0.0:
+		_t = maxf(_t, SHOW_MS - OUT_MS)   # its 120 ms fade-out, then the dock's gap
+
+
 ## True while nothing is showing and nothing waits (the C1 ping's allowPing half).
 func idle() -> bool:
 	return _t < 0.0 and _queue.is_empty()
