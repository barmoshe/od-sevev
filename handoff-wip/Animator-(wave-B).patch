+	runner.check(w.dx_ap() == 0 and w.alpha() == 0.0 and w.left_ms() == LeaderWalk.RM_FADE_MS, "in: on the mark, transparent, 150 ms to go")
+	w.advance(160.0)
+	runner.check(w.state() == "home" and w.alpha() == 1.0, "in: shown after 150 ms")
+
