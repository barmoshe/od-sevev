-    for m in (ui_chat, ui_controls, ui_meters, ui_widgets, wordmark, ui_events, props, ui_share, wave2, sources, dubi_small, wave5, wave6, wave7, wave8, leaders):
+    for m in (ui_chat, ui_controls, ui_meters, ui_widgets, wordmark, ui_events, props, ui_share, wave2, sources, dubi_small, wave5, wave6, wave7, wave8, wave9, leaders):
         m.build()
     print(write_manifest(), len(REGISTRY), "pieces")
