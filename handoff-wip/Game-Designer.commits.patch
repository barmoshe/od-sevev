From 21160ecabc43d627dcbfa1269f7f901cc73f40fe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 20:30:26 +0000
Subject: [PATCH 1/3] fix(od-sevev): drop the NUL cache key in leaders.gd and
 fail tests on Unicode parse errors

The installed-round cache key started as "\u0000", which Godot printed as
"Unicode parsing error" on every run. No built key is empty, so "" is the
sentinel now; tools/test.sh treats that error like a script error.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JZ6f2h5tcXVKGAwuAga5z8
---
 game/scripts/sim/leaders.gd | 4 ++--
 tools/test.sh               | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/game/scripts/sim/leaders.gd b/game/scripts/sim/leaders.gd
index 4277864..fb7db74 100644
--- a/game/scripts/sim/leaders.gd
+++ b/game/scripts/sim/leaders.gd
@@ -44,7 +44,7 @@ const OVERRIDABLE := ["rejoinMult", "poachSec", "patienceSec", "demandSec", "min
 
 # ---- the installed round (a cache of the state's leader + deal over the loaded content) ----
 static var _c: Dictionary = {}          # the content object it was built from (is_same)
-static var _key := "\u0000"
+static var _key := ""           # no built key is "" (each holds "|"); a NUL sentinel printed "Unicode parsing error"
 static var _state_id := 0
 static var _state_ver := -1
 static var _leader := ""
@@ -208,7 +208,7 @@ static func first_partner() -> String:
 static func _refresh_content() -> void:
 	if not is_same(_c, Content.data()):
 		_c = Content.data()
-		_key = "\u0000"
+		_key = ""
 		_state_id = 0
 		_state_ver = -1
 		_leader = default_leader()
diff --git a/tools/test.sh b/tools/test.sh
index 17d951d..6f82d86 100755
--- a/tools/test.sh
+++ b/tools/test.sh
@@ -10,7 +10,8 @@ LOG="$(mktemp)"
 "$HERE/godot.sh" --headless --path "$GAME" -s res://tests/run_tests.gd -- "$@" 2>&1 | tee "$LOG"
 code=${PIPESTATUS[0]}
 # "String formatting error": a bad `%` in a message ("5% ×" needs "%%"; GDScript has no %g).
-if grep -qE "SCRIPT ERROR|Parse Error|Invalid call|Invalid access|Nonexistent function|String formatting error" "$LOG"; then
+# "Unicode parsing error": a NUL or broken UTF-8 in a script or string (leaders.gd's old "\u0000" key).
+if grep -qE "SCRIPT ERROR|Parse Error|Invalid call|Invalid access|Nonexistent function|String formatting error|Unicode parsing error" "$LOG"; then
   echo "tools/test.sh: engine reported script errors" >&2
   code=1
 fi
-- 
2.43.0


