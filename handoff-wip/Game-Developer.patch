++	_commit = {}
++	_press = {}
++	_hover = -1
++	_age = 0.0
++	modulate.a = 1.0
++	visible = true
++	_build()
++	focus = -1
++	if focus_id != "":
++		for i in cells.size():
++			if str(cells[i]["id"]) == focus_id:
++				focus = i
