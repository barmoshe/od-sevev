+  "#1e1636": "ui_panel -> v3 ui_panel #0a1a42 (dossier and chat thread backgrounds)",
+  "#2e2250": "ui_bubble -> v3 ui_bubble #112a64 (Dubi's bubble, the share mask)",
+  "#4a3c7c": "ui_bub_hi -> v3 #26499c (bevel light; listed for completeness)",
+  "#4a2552": "plum -> v3 velvet blue #16357a (project.godot boot splash; design/content.json Balfour skyBands already moved)",
