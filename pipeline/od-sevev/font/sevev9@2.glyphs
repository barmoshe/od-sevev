# ---- aliases
alias U+0061..U+0077 -> U+0041..U+0057 lowercase a-w draws the body-height capital
alias U+0079..U+007A -> U+0059..U+005A lowercase y-z (x keeps its own multiplier glyph)
alias U+00A0 -> U+0020 no-break space (UX: number NBSP ₪)
alias U+2018 -> U+0027 left single quote
alias U+2019 -> U+0027 right single quote
alias U+201C -> U+0022 left double quote
alias U+201D -> U+0022 right double quote
alias U+201E -> U+0022 low double quote
alias U+2715 -> U+00D7 heavy x (✕ close buttons) -> ×
alias U+2022 -> U+00B7 bullet -> middle dot
# ---- zero-width format characters (TextServer does the bidi; the font must never box them)
zero U+200B ZWSP
zero U+200C ZWNJ
zero U+200D ZWJ
zero U+200E LRM
zero U+200F RLM
zero U+202A LRE
zero U+202B RLE
zero U+202C PDF
zero U+202D LRO
zero U+202E RLO
zero U+2066 LRI
zero U+2067 RLI
zero U+2068 FSI
zero U+2069 PDI
zero U+FEFF BOM/ZWNBSP
zero U+FE0E VS15 text presentation
zero U+FE0F VS16 emoji presentation (content writes ⬅️, ⚖️)
