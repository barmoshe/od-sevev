          "delayMs": 0,
          "pixelSnap": 4,
          "count": 3,
          "bindings": { "count": "tapChipCount", "speed": "tapChipSpeed", "lifespan": "tapChipLifeMs", "gravityY": "chipGravity" },
          "spread": { "speed": 0.15 },
          "arc": { "centerDeg": 270, "widthDeg": 180, "widthParam": "tapChipArcDeg" },
          "reducedMotion": { "countFactor": "reducedMotionChipFactor" },
          "config": {
